PORT=5000
NODE_ENV=development
# Database Connection (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/gaming_lounge
# Atlas: mongodb+srv://<username>:<password>@<cluster-address>/gaming_lounge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gaming_lounge
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://client-ebon-ten-20.vercel.app
CORS_ORIGIN=http://localhost:5173,https://client-ebon-ten-20.vercel.app
TIMEZONE=Asia/Kolkata

# Razorpay Payment Gateway (Test Mode Only)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Resend Transactional Email Configuration
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Web Push Notifications (VAPID Configuration)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-verified-email@example.com

# Primary Administrator Configuration
PRIMARY_ADMIN_EMAIL=royalofficial2004@gmail.com

# Cloudinary Image Management (Secure Signed Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External Game Metadata API (RAWG / IGDB)
GAME_METADATA_PROVIDER=rawg
RAWG_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
